{
  "name": "yapper-desktop",
  "productName": "Yapper",
  "version": "1.1.0",
  "description": "Yapper desktop client for macOS, ported from the supplied Linux package.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/make-icon.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "build:mac:arm64": "node scripts/build-mac.mjs --arch=arm64",
    "build:mac:x64": "node scripts/build-mac.mjs --arch=x64",
    "build:mac:all": "node scripts/build-mac.mjs --arch=all"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.1.0"
  }
}
